# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/database_agent

# MinIO
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=documents
MINIO_SECURE=false

# SQLite storage path
SQLITE_DATA_PATH=./data/sqlite

# LLM APIs
ANTHROPIC_API_KEY=sk-ant-...

# Encryption (for connector connection strings)
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=your-fernet-key-here

# Shared secret for module-to-module integration endpoints (X-API-Key header).
# Leave empty to disable /api/integrations endpoints.
INTEGRATION_API_KEY=

# Chunking config (defaults: 1500/200 — see src/config.py)
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=200

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
DEBUG=true

# Frontend
VITE_API_URL=http://localhost:8001
